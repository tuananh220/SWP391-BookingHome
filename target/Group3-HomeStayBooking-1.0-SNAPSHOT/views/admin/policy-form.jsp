<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>${policy.policyId > 0 ? 'Chỉnh sửa' : 'Thêm'} chính sách</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/catalog.css?v=3"></head><body class="admin-body">
        <aside class="admin-sidebar"><a class="admin-logo" href="${pageContext.request.contextPath}/admin/dashboard">HOMESTAY<br><span>ADMIN</span></a><nav><a href="${pageContext.request.contextPath}/admin/dashboard">Tổng quan</a><a class="active" href="${pageContext.request.contextPath}/admin/policies">Chính sách hủy</a></nav><form method="post" action="${pageContext.request.contextPath}/logout"><button>Đăng xuất</button></form></aside>
        <main class="admin-main"><header class="admin-page-head"><div><p class="eyebrow">POLICY EDITOR</p><h1>${policy.policyId > 0 ? 'Chỉnh sửa chính sách' : 'Thêm chính sách'}</h1></div><a href="${pageContext.request.contextPath}/admin/policies">← Danh sách</a></header><c:if test="${not empty error}"><div class="notice error"><c:out value="${error}"/></div></c:if>
            <form method="post" action="${pageContext.request.contextPath}/admin/policy-form" class="admin-editor policy-editor"><input type="hidden" name="policyId" value="${policy.policyId}"><label>Tên chính sách<input name="policyName" maxlength="100" required value="<c:out value='${policy.policyName}'/>"></label><label>Mô tả<textarea name="description" rows="5"><c:out value="${policy.description}"/></textarea></label><div class="admin-field-grid"><label>Số ngày hoàn 100%<input type="number" min="0" name="fullRefundDays" required value="${policy.fullRefundDays}"></label><label>Số ngày hoàn một phần<input type="number" min="0" name="partialRefundDays" required value="${policy.partialRefundDays}"></label></div><label>Phần trăm hoàn một phần<input type="number" min="0" max="100" step="0.01" name="partialRefundPercent" required value="${policy.partialRefundPercent}"></label><div class="policy-preview"><span>Hủy trước ít nhất <b>${policy.fullRefundDays}</b> ngày → hoàn 100%</span><span>Hủy trước ít nhất <b>${policy.partialRefundDays}</b> ngày → hoàn ${policy.partialRefundPercent}%</span><span>Hủy muộn hơn → không hoàn tiền</span></div><div class="property-form-actions"><a href="${pageContext.request.contextPath}/admin/policies">Hủy</a><button>Lưu chính sách</button></div></form></main></body></html>

