@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam actorStyle awesome

title Home Owner Use Case Diagram

actor "Home Owner" as HomeOwner

rectangle "HomeStay Booking System - Home Owner" {
  usecase "Manage Homestays" as Homestays
  usecase "Create Homestay" as CreateHomestay
  usecase "Update Homestay" as UpdateHomestay
  usecase "Delete / Hide Homestay" as DeleteHomestay
  usecase "Manage Amenities" as Amenities
  usecase "Create Amenity" as CreateAmenity
  usecase "Update Amenity" as UpdateAmenity
  usecase "Delete Amenity" as DeleteAmenity
  usecase "Manage Vouchers" as Vouchers
  usecase "Create Voucher" as CreateVoucher
  usecase "Update Voucher" as UpdateVoucher
  usecase "Delete / Deactivate Voucher" as DeleteVoucher
  usecase "View Booking Requests" as BookingRequests
  usecase "Confirm / Reject Booking" as ProcessBooking
  usecase "View Booking Schedule" as Schedule
  usecase "Manage Availability and Daily Price" as Availability
  usecase "Process Stay Change Requests" as ProcessStayChanges
  usecase "View Revenue Reports" as Revenue
  usecase "View Booking History" as BookingHistory
}

HomeOwner --> Homestays
HomeOwner --> Amenities
HomeOwner --> Vouchers
HomeOwner --> BookingRequests
HomeOwner --> ProcessBooking
HomeOwner --> Schedule
HomeOwner --> Availability
HomeOwner --> ProcessStayChanges
HomeOwner --> Revenue
HomeOwner --> BookingHistory

CreateHomestay ..> Homestays : <<extend>>
UpdateHomestay ..> Homestays : <<extend>>
DeleteHomestay ..> Homestays : <<extend>>
CreateAmenity ..> Amenities : <<extend>>
UpdateAmenity ..> Amenities : <<extend>>
DeleteAmenity ..> Amenities : <<extend>>
CreateVoucher ..> Vouchers : <<extend>>
UpdateVoucher ..> Vouchers : <<extend>>
DeleteVoucher ..> Vouchers : <<extend>>
Availability ..> Schedule : <<extend>>

@enduml
