@startuml
' Admin screen flow
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #FFF5F5
  BorderColor #9B2C2C
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #B7791F
  StartColor #2F855A
  EndColor #C53030
  ArrowColor #4A5568
}

title Admin Screen Flow

start
:Admin Login\n(/login);
:Admin Dashboard\n(/admin/dashboard);

partition "User Accounts" {
  :User List\n(/admin/users);
  if (Manage account?) then (Yes)
    :User Form\n(/admin/user-form);
    :Create or update account;
    :User Action\n(/admin/user-action);
    :User List;
  else (No)
  endif
}

partition "Homestays" {
  :Homestay List\n(/admin/homestays);
  :Homestay Detail\n(/admin/homestay-detail);
  if (Edit homestay?) then (Yes)
    :Homestay Edit\n(/admin/homestay-edit);
    :Update homestay information;
  else (No)
  endif
  :Homestay Action\n(/admin/homestay-action);
  :Homestay List;
}

partition "Reviews" {
  :Review List\n(/admin/reviews);
  :Review Detail\n(/admin/review-detail);
  if (Edit or moderate review?) then (Yes)
    :Review Edit\n(/admin/review-edit);
    :Review Action\n(/admin/review-action);
  else (No)
  endif
  if (Review report?) then (Yes)
    :Review Report Action\n(/admin/review-report-action);
  else (No)
  endif
  :Review List;
}

partition "Policies" {
  :Cancellation Policy List\n(/admin/policies);
  if (Create or update policy?) then (Yes)
    :Policy Form\n(/admin/policy-form);
    :Save policy;
    :Policy Action\n(/admin/policy-action);
  else (No)
  endif
  :Cancellation Policy List;
}

partition "System Content" {
  :Blog List\n(/admin/blogs);
  if (Manage blog?) then (Yes)
    :Blog Form\n(/admin/blog-form);
    :Create or update blog;
    :Blog Action\n(/admin/blog-action);
  else (No)
  endif
  :Banner List\n(/admin/banners);
  if (Manage banner?) then (Yes)
    :Banner Form\n(/admin/banner-form);
    :Create or update banner;
    :Banner Action\n(/admin/banner-action);
  else (No)
  endif
}

:Return to Admin Dashboard;
:Logout\n(/logout);
stop
@enduml
