@startuml
' Home owner screen flow
skinparam shadowing false
skinparam dpi 150
skinparam defaultFontName Arial
skinparam activity {
  BackgroundColor #F0FFF4
  BorderColor #276749
  DiamondBackgroundColor #FFF4D6
  DiamondBorderColor #B7791F
  StartColor #2F855A
  EndColor #C53030
  ArrowColor #4A5568
}

title Home Owner Screen Flow

start
:Home Owner Login\n(/login);
:Host Dashboard\n(/host/dashboard);

partition "Homestay Management" {
  :Homestay List\n(/host/homestays);
  if (Create homestay?) then (Yes)
    :Homestay Form\n(/host/homestay-form);
    :Save Homestay;
  elseif (Edit homestay?) then (Yes)
    :Homestay Form\n(/host/homestay-form?id=...);
    :Update Homestay;
  elseif (Change status?) then (Yes)
    :Homestay Action\n(/host/homestay-action);
  else (Continue)
  endif
}

partition "Amenities and Vouchers" {
  :Amenity List\n(/host/amenities);
  if (Manage amenity?) then (Yes)
    :Amenity Form\n(/host/amenity-form);
    :Create or update amenity;
    :Amenity Action\n(/host/amenity-action);
  else (No)
  endif
  :Voucher List\n(/host/vouchers);
  if (Manage voucher?) then (Yes)
    :Voucher Form\n(/host/voucher-form);
    :Create or update voucher;
    :Voucher Action\n(/host/voucher-action);
  else (No)
  endif
}

partition "Bookings" {
  :Booking Request List\n(/host/bookings);
  :Booking Detail\n(/host/booking-detail);
  if (Process booking?) then (Yes)
    :Confirm / Reject / Cancel Booking\n(/host/booking-action);
    :Booking Request List;
  else (No)
  endif
}

partition "Schedule and Requests" {
  :Booking Schedule and Daily Price\n(/host/schedule);
  :Stay Change Request List\n(/host/stay-change-requests);
  if (Process stay change request?) then (Yes)
    :Accept or reject request\n(/host/stay-change-action);
    :Stay Change Request List;
  else (No)
  endif
}

partition "Reports" {
  :Host Dashboard\n(/host/dashboard?period=7days|30days|1year);
  :Revenue and booking status charts;
}

:Logout\n(/logout);
stop
@enduml
